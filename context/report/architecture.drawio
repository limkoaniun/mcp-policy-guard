<mxfile host="app.diagrams.net" modified="2026-10-04T00:00:00.000Z" agent="mcp-policy-guard" version="24.0.0">
  <diagram id="sys-arch" name="1 — System architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

