          <mxGeometry x="40" y="230" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;local LLM via Ollama&lt;br&gt;&lt;font size=&quot;1&quot;&gt;reads chat + tool results,&lt;br&gt;proposes tool calls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="210" y="210" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="proxy" value="&lt;b&gt;Policy Guard proxy&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;deterministic, no model inside · allow / deny / hold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="260" height="320" as="geometry" />
        </mxCell>

        <mxCell id="allowlist" value="1 · Tool allowlist&#10;&quot;is this tool declared for this task?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="475" y="185" width="210" height="48" as="geometry" />
        </mxCell>

        <mxCell id="principal" value="2 · Principal binding&#10;&quot;does the call name the task&#39;s own student?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="475" y="243" width="210" height="48" as="geometry" />
        </mxCell>

        <mxCell id="argval" value="3 · Argument validation&#10;&quot;prerequisites met? no anti-requisite? credit cap OK?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="475" y="301" width="210" height="58" as="geometry" />
        </mxCell>

        <mxCell id="taint" value="4 · Taint tracking&#10;&quot;side-effecting call after an untrusted read?&quot; → held for the user&#39;s confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="475" y="369" width="210" height="68" as="geometry" />
        </mxCell>

        <mxCell id="server" value="&lt;b&gt;Enrolment MCP server&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;eleven tools: search · check · enrol&lt;br&gt;· drop · eRequest ·&lt;br&gt;get_attachment · …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="795" y="205" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="data" value="students.json&#10;+ UTS catalogue&#10;&amp; requisite rules" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
