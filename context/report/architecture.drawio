  </diagram>
  <diagram id="call-flow" name="2 — Life of one tool call">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Agent proposes a tool call&#10;e.g. enrol(student_id=S9000001, code=32513)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="30" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="1 · On the task&#39;s&#10;tool allowlist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="410" y="120" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d1b" value="2 · Names the task&#39;s&#10;own student?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="410" y="230" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="3 · Arguments pass the rules?&#10;prerequisites · anti-requisites&#10;· credit cap, against the live record" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="385" y="340" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="4 · Side-effecting call, and the run&#10;has read an untrusted document?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="385" y="480" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="allow" value="ALLOW: forward to the enrolment server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="exec" value="Server runs it;&#10;student record updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="720" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="deny" value="DENY: the call never&#10;reaches the server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="780" y="300" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="denymsg" value="A plain-English reason&#10;is returned to the agent&#10;(&quot;32513 requires 32130 …&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="780" y="390" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="hold" value="REQUIRE APPROVAL: the call is held;&#10;the reason names the untrusted tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="780" y="500" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="holdmsg" value="User confirms → replayed and&#10;logged as confirmed.&#10;User refuses → nothing runs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="780" y="590" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="flog" value="decisions.jsonl&#10;(audit log:&#10;every verdict)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="440" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="f1" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f2" value="yes" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d1b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f3" value="no" style="endArrow=classic;html=1;rounded=0;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="deny">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="f2b" value="yes" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1b" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f3b" value="no" style="endArrow=classic;html=1;rounded=0;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="d1b" target="deny">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f4" value="yes" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f5" value="no" style="endArrow=classic;html=1;rounded=0;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="d2" target="deny">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f4b" value="no" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;fontColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="allow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f5b" value="yes" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;fontColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="hold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f6" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="allow" target="exec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f7" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="deny" target="denymsg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f7b" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hold" target="holdmsg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f8" value="every verdict logged" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.35;" edge="1" parent="1" source="d2" target="flog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f9" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="allow" target="flog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="A deny from gates 1–3 short-circuits, so a rule-breaking call is refused as a rule violation even when the run is tainted. Every verdict is computed and logged even with enforcement OFF; the toggle only forces the forwarding decision, which is what makes the on/off comparison fair." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="250" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
