        <mxCell id="e3" value="forwarded only if allowed" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="proxy" target="server">
          <mxGeometry relative="1" as="geometry" />
