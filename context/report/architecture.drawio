        <mxCell id="f9" value="logged" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="allow" target="flog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="Both outcomes are computed even with enforcement OFF; the toggle only forces the forwarding decision, which is what makes the on/off comparison fair." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
