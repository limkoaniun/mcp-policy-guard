        <mxCell id="note1" value="Gates 1–4 are active and evaluated (§6). Designed but not active in the evaluated prototype: rate &amp;amp; scope limits." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
