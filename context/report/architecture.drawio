        <mxCell id="upload" value="&lt;b&gt;Uploaded document&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;an RPL form, a letter, a forum template:&lt;br&gt;written by anyone, so untrusted&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde9e7;strokeColor=#CC0000;" vertex="1" parent="1">
