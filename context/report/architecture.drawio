        <mxCell id="pack" value="&lt;b&gt;Policy pack&lt;/b&gt; (YAML)&lt;br&gt;&lt;font size=&quot;1&quot;&gt;the rules: which policies run,&lt;br&gt;which tools are untrusted&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="615" y="500" width="160" height="70" as="geometry" />
