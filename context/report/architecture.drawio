        <mxCell id="log" value="&lt;b&gt;decisions.jsonl&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;every verdict logged&lt;br&gt;for audit&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
