        <mxCell id="e9" value="read via get_attachment" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#CC0000;fontColor=#CC0000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="upload" target="server">
