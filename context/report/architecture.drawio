        <mxCell id="task" value="&lt;b&gt;Task&lt;/b&gt; (YAML)&lt;br&gt;&lt;font size=&quot;1&quot;&gt;who the student is +&lt;br&gt;which tools are allowed&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
