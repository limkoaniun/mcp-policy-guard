        <mxCell id="f8" value="logged" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.35;" edge="1" parent="1" source="d2" target="flog">
          <mxGeometry relative="1" as="geometry" />
